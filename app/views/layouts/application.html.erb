<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Folio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Role board. Paste a listing, match it against your skills, drag the card.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
  </head>
  <body>
    <div class="shell">
      <header class="mast">
        <div>
          <p class="eyebrow">Role board</p>
          <p class="wordmark"><%= link_to "Folio", root_path %></p>
        </div>
        <p class="lede">
          Save a role, paste the listing, see what fits. Drag the card
          as you apply. Matching is words in the listing against your
          skills, not a model.
        </p>
      </header>
      <main>
        <%= yield %>
      </main>
    </div>
    <%= javascript_include_tag "folio", type: "module" %>
  </body>
</html>
